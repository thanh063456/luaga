# Ollama Local AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Auth Secret (dùng cho mã hóa phiên đăng nhập & mã hóa thông tin nhạy cảm)
AUTH_SECRET=your_random_secret_here

# Telegram Bot (Tùy chọn nhận thông báo tuyển dụng và hàng đợi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets API (Service Account - Tùy chọn đồng bộ tin tuyển dụng)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Sheet1

